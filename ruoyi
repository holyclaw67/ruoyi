# Last reviewed: 29 April 2026
# =============================================================================


# --- domain port from ruoyi oracle: db_detect_engine ---
db_detect_engine() {
    # --- Safe Variable Defaults ---
    : "${DB_ENGINE:=mariadb}"   # Default is MariaDB
    : "${FORCE_MYSQL:=0}"
    : "${FORCE_MARIADB:=0}"

    if [ "${FORCE_MYSQL}" -eq 1 ] && [ "${FORCE_MARIADB}" -eq 1 ]; then
        out_die "Cannot use both --mysql and --mariadb at the same time"
    fi

