            out_warn "⚠️  Keeping root user as requested" >&2
        fi
    else
        out_info "non-root db-user: ${final_db_user}" >&2
    fi

    if [ "$use_existing" = "1" ]; then
        out_info "Re-using existing valid credentials from application-druid.yml" >&2
    else
        final_db_pass=$(db_create_new_user "$final_db_user" "${final_db_pass:-$(util_generate_db_pass)}" "$final_db_name")
    fi

    # GRANT only for new users
    if [ "$use_existing" != "1" ]; then
        sudo mysql -e "GRANT ALL PRIVILEGES ON \`${final_db_name}\`.* TO '${final_db_user}'@'localhost';" 2>/dev/null || true
        sudo mysql -e "FLUSH PRIVILEGES;" 2>/dev/null || true
    fi

    # === Schema import - use the SAME db name as config ===
    local sql_file=$(ls sql/ry*.sql 2>/dev/null | sort -r | head -n 1)
    if [ -n "$sql_file" ]; then
        sudo mysql "${final_db_name}" < "$sql_file" && \
            out_info "Main schema imported into ${final_db_name}" || \
            out_warn "Schema import failed"
    fi
    if [ -f "sql/quartz.sql" ]; then
        sudo mysql "${final_db_name}" < sql/quartz.sql && \
            out_info "Quartz tables imported into ${final_db_name}" || \
            out_warn "Quartz import failed"
    fi

    # === Schema import (always after DB+user is ready) ===
    local sql_file=$(ls sql/ry*.sql 2>/dev/null | sort -r | head -n 1)
    if [ -n "$sql_file" ]; then
        sudo mysql "${final_db_name}" < "$sql_file" && out_info "Main schema imported" || out_warn "Schema import failed"
    fi
    if [ -f "sql/quartz.sql" ]; then
        sudo mysql "${final_db_name}" < sql/quartz.sql && out_info "Quartz tables imported" || out_warn "Quartz import failed"
    fi

    # Final test
    out_info "Performing final connection test..."
    if db_test_credentials "$final_db_user" "$final_db_pass" "$final_db_name"; then
        out_success "✅ Final database connection test passed"
    else
        out_warn "⚠️ Final test failed (check manually)"
    fi

    # === SAFE & PRECISE YAML UPDATE v5 (Loud EXPECTED) ===
    local config_file="ruoyi-admin/src/main/resources/application-druid.yml"
    local full_config_path="${PROJECT_DIR}/${config_file}"

    if [ -f "${full_config_path}" ]; then
        util_backup "${full_config_path}" "final-credentials" || true

        out_double_line >&2
        out_info "=== TARGET / EXPECTED VALUES ===" >&2
        out_info "  username : ${final_db_user}" >&2
        out_info "  password : ${final_db_pass}" >&2
        out_double_line >&2

        out_info "=== BEFORE ===" >&2
        grep -E '^( *url:| *username:| *password:)' "${full_config_path}" | sed 's/^/  /' >&2

        awk -v user="${final_db_user}" -v pass="${final_db_pass}" '
            /^[[:space:]]*username:[[:space:]]/ { print "                username: " user; next }
            /^[[:space:]]*password:[[:space:]]/ { print "                password: " pass; next }
            { print }
        ' "${full_config_path}" > "${full_config_path}.tmp" && \
        mv "${full_config_path}.tmp" "${full_config_path}" || out_warn "YAML update failed"

        out_info "=== AFTER ===" >&2
        grep -E '^( *url:| *username:| *password:)' "${full_config_path}" | sed 's/^/  /' >&2
        out_double_line >&2

        out_success "✅ Updated application-druid.yml (user=${final_db_user})"
    fi

    # Final messages
    out_success "Database setup completed successfully!"
    out_success "Database : ${final_db_name}"
    out_success "User     : ${final_db_user}"
    
    if [ "$use_existing" = "1" ]; then
        out_success "Password : (using existing password from MariaDB)"
        out_success "→ Re-used existing credentials from application-druid.yml"
    else
        out_success "Password : ${final_db_pass}   ← Please save this password!"
        out_success "→ New user created + configuration updated"
    fi
}

