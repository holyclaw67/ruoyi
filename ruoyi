            sh|dash|ash|busybox)
                printf '%s\n' "ruoyi requires bash for SDKMAN/Java domain. Use: curl -fsSL <url> | bash" >&2
                exit 1
                ;;
            *)
                exec bash "$0" "$@"
                ;;
        esac
    else
        printf '%s\n' "ruoyi requires bash, but bash was not found on PATH." >&2
        exit 1
    fi
fi

