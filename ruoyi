# --- domain port fix: ruo_about ---
ruo_about() {
    : "${PORT:=8080}"
    : "${PROJECT_DIR:=${HOME}/${PROJECT_NAME:-ruoyi-demo}}"
    : "${APP_NAME:=ruoyi}"
    : "${VERSION:=2.3.2}"
    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    : "${STORAGE_DIR:=${XDG_CACHE_HOME:-${HOME}/.cache}/${APP_NAME}-${USERNAME}}"
    if [ "${JSON}" -eq 1 ]; then
        # === JSON MODE - Clean machine output ===
        local installed="false"
        inst_is_installed && installed="true"

        local sdkman_status="not found"
        [ -d "${HOME}/.sdkman" ] && sdkman_status="installed"

        local java_version="not found"
        if command -v java >/dev/null 2>&1; then
            java_version=$(java -version 2>&1 | head -n 1 | tr -d '\n\r')
        fi

        local maven_version="not found"
        if command -v mvn >/dev/null 2>&1; then
            maven_version=$(mvn --version | head -n 1 | tr -d '\n\r')
        fi

        local project_exists="false"
        [ -d "${PROJECT_DIR}" ] && project_exists="true"

        local app_running="false"
        if command -v ss >/dev/null 2>&1 && ss -tuln 2>/dev/null | grep -q ":${PORT}"; then
            app_running="true"
        elif command -v netstat >/dev/null 2>&1 && netstat -tuln 2>/dev/null | grep -q ":${PORT}"; then
            app_running="true"
        fi

        # Clean JSON output - no generic message
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "installed" "${installed}" \
            "sdkman" "${sdkman_status}" \
            "java" "${java_version}" \
            "maven" "${maven_version}" \
            "project_dir" "${PROJECT_DIR}" \
            "project_exists" "${project_exists}" \
            "port" "${PORT}" \
            "app_running" "${app_running}" \
            "user" "${USERNAME}" \
            "shell" "$(ps -p $$ -o comm= 2>/dev/null | tr -d '()')" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}"

        return 0
    fi

    # === HUMAN-READABLE MODE ===
    [ "${QUIET}" -eq 1 ] && return 0

    msg "=== ${APP_NAME} ${VERSION} - Full Diagnostics ==="
    out_empty_line

    if inst_is_installed; then
        out_success "${APP_NAME} is installed at ${INSTALL_PATH}"
    else
        out_warn "${APP_NAME} is NOT installed."
    fi

    out_empty_line

    # SDKMAN
    if [ -d "${HOME}/.sdkman" ]; then
        out_success "SDKMAN     : installed"
    else
        out_warn "SDKMAN     : not found"
    fi

    # Java
    if command -v java >/dev/null 2>&1; then
        msg "Java       : $(java -version 2>&1 | head -n 1)"
    else
        out_warn "Java       : not found"
    fi

    # Maven
    if command -v mvn >/dev/null 2>&1; then
        msg "Maven      : $(mvn --version | head -n 1)"
    else
        out_warn "Maven      : not found"
    fi

    # Project
    if [ -d "${PROJECT_DIR}" ]; then
        out_success "Project    : ${PROJECT_DIR} (exists)"
    else
        out_warn "Project    : ${PROJECT_DIR} (does not exist)"
    fi

    # App running status
    local running_status="no"
    if command -v ss >/dev/null 2>&1 && ss -tuln 2>/dev/null | grep -q ":${PORT}"; then
        running_status="yes"
    elif command -v netstat >/dev/null 2>&1 && netstat -tuln 2>/dev/null | grep -q ":${PORT}"; then
        running_status="yes"
    fi
    msg "App on port ${PORT} : ${running_status}"

    out_empty_line
    out_info "Storage (effective): ${EFFECTIVE_STORAGE_DIR}"
    out_info "Storage (config)   : ${STORAGE_DIR}"

    out_empty_line
    msg "Use '${APP_NAME} about --json' for machine-readable output."
    msg "Current project directory can be changed with --project-dir <path>"
}

# =============================================================================
# ruo_help() - Display help information
# =============================================================================
#
# GENERAL PURPOSE:
# Shows usage instructions, available commands, and important notes for RuoYi.
# Fully supports --quiet and --json modes.
#
# CRITICAL DESIGN:
# This function must NEVER use raw `cat`, `echo`, or `printf` for user-visible
# output. All text must go through the single source of truth (`out_text()`).
#
# --json implies --quiet: Handled globally by out_text(). This function only
# decides between normal help text and JSON payload.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Past AI assistants have repeatedly replaced structured help with raw `cat << EOF`,
# which completely breaks --quiet and --json consistency.
#
# This version maintains full compatibility with the defensive output architecture
# used across all Wilgat/CIAO tools.
#
# Last reviewed: 29 April 2026
# =============================================================================

ruo_help() {
    : "${APP_NAME:=ruoyi}"
    : "${PROJECT_DIR:=${HOME}/${PROJECT_NAME:-ruoyi-demo}}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "help" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "commands" "install,version,about,help,version-check,self-update,self-uninstall,setup,mariadb,mysql,redis,run,db-extract"
        return 0
    fi
    out_info "${APP_NAME} — ${APP_DESC:-RuoYi one-command setup}"
    out_plain "${DESCRIPTION:-}"
    out_empty_line
    out_info "Usage:"
    out_plain "  ${APP_NAME} [command] [options]"
    out_empty_line
    out_info "RuoYi domain commands:"
    out_plain "  setup                Ensure SDKMAN + Java 21 + Maven + clone RuoYi project"
    out_plain "  mariadb|mysql|db     Setup MariaDB or MySQL for RuoYi (may use sudo internally)"
    out_plain "  redis                Install and start Redis for RuoYi"
    out_plain "  run                  Build and run ruoyi-admin"
    out_plain "  db-extract [PATH]    Extract DB credentials from application-druid.yml"
    out_empty_line
    out_info "Self-Management (Type 0 — from selfmanaged architecture):"
    out_plain "  install              Install ${APP_NAME} CLI (root→global, user→~/.local/bin)"
    out_plain "  version              Show current version"
    out_plain "  about                Show diagnostics (stack + install state)"
    out_plain "  version-check        Compare local vs remote version (needs SCRIPT_URL)"
    out_plain "  self-update          Update CLI from SCRIPT_URL"
    out_plain "  self-uninstall       Remove CLI (safe PATH cleanup)"
    out_plain "  help                 Show this help"
    out_empty_line
    out_info "Global Options:"
    out_plain "  --project-dir PATH   Override PROJECT_DIR"
    out_plain "  --no-run             With setup: skip run after clone"
    out_plain "  --quiet, -q          Suppress info/success"
    out_plain "  --json               Machine-readable JSON (implies --quiet)"
    out_plain "  --force              Force reinstall / skip uninstall confirm"
    out_plain "  --debug              Debug diagnostics on stderr"
    out_empty_line
    out_info "Environment:"
    out_plain "  REPO_USER / REPO_NAME / SCRIPT_URL   Install channel (default cloudgen/ruoyi)"
    out_plain "  PROJECT_DIR                         RuoYi project path (default \$HOME/ruoyi-demo)"
    out_plain "  PORT                                App port (default 8080)"
    out_empty_line
    out_info "Examples:"
    out_plain "  curl -fsSL https://raw.githubusercontent.com/cloudgen/ruoyi/main/ruoyi | bash"
    out_plain "  ${APP_NAME} setup --no-run"
    out_plain "  ${APP_NAME} mariadb"
    out_plain "  ${APP_NAME} run"
    out_plain "  ${APP_NAME} db-extract --json"
}


# =============================================================================
# util_src_user_shell_conf() - Safely source user shell configuration
# =============================================================================
#
# Purpose:
#   Many sub-commands (about, version, status, build & run, etc.) are executed
#   in a non-interactive, non-login shell.
#
#   In such shells, ~/.bashrc (and other user config files) are usually NOT
#   sourced automatically. This causes problems when users have important
#   settings in their ~/.bashrc such as:
#     - PATH modifications
#     - SDKMAN initialization
#     - Custom environment variables
#     - Aliases or functions
#
#   This function ensures the user's normal shell environment is available
#   for all meaningful operations of springboot2/springboot3/springboot4.
#
# Why this is needed:
#   - The main "curl | bash" install runs in a clean shell.
#   - Sub-commands like "springboot2/springboot3/springboot4 about" or "springboot2/springboot3/springboot4" (normal run)
#     must respect the user's configured environment.
#   - SDKMAN users especially need sdkman-init.sh to be loaded.
#
# Design choices (defensive):
#   - Only sources once (avoids double sourcing issues)
#   - Skips completely in --quiet and --json modes (clean output)
#   - Tries common config files in sensible order
#   - Suppresses all output and errors during sourcing (never breaks script)
#   - Always succeeds (return 0) so it never breaks the main flow
#   - Special handling for SDKMAN because it is critical for this script
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# This function protects user environment consistency across all sub-commands.
# It is intentionally verbose with heavy comments following CIAO style.
#
# Last reviewed: 29 April 2026
# =============================================================================



app_main() {
    # --- Safe Variable Defaults ---
    : "${COMMAND:=help}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${NO_RUN:=0}"
    : "${PROJECT_DIR:=${HOME}/${PROJECT_NAME:-ruoyi-demo}}"
    : "${PORT:=8080}"

    # Effective scratch/cache root for this run (requirement-shell-cli-storage).
    # Priority: /dev/shm → /tmp → STORAGE_DIR (persistent cache fallback).
    # Resolver creates root fail-closed. Export TMPDIR so mktemp -t (install
    # download stage) lands under the isolated product root.
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # === ZERO-ARG = Type O install-ensure (curl | bash contract) ===
    # Product type: Type O (online-install) — not Type N help-default.
    # Empty argv always means "ensure installed", never help.
    # Cases: not installed | installed local | installed global
    # - not installed → install (TTY prompt via inst_maybe_install; non-TTY auto)
    # - already installed → success no-op (inst_perform_install); no --force required
    # - --force / FORCE_REINSTALL only for deliberate re-download/replace
    # Exit status must reflect install outcome (failed download/checksum → non-zero).
    # SSOT: docs/requirements/requirement-shell-cli-zero-arguments.md
    if [ $# -eq 0 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
            inst_perform_install
            exit $?
        elif inst_is_installed; then
            inst_perform_install
            exit $?
        else
            inst_maybe_install
            exit $?
        fi
    fi

    # === Argument parsing: flags and commands (order-independent) ===
    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            version|about|help|version-check|self-update|self-uninstall|install)
                COMMAND="$1"
                ;;
            setup|mariadb|mysql|db|redis|run|db-extract)
                COMMAND="$1"
                ;;
            --project|--project-dir)
                if [ -z "${2-}" ]; then
                    out_die "$1 requires a path"
                fi
                PROJECT_DIR="$2"
                shift
                ;;
            --no-run)
                NO_RUN=1
                ;;
            *)
                out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE}"

    case "${COMMAND}" in
        version)
            app_version
            ;;
        about)
            ruo_about
            ;;
        version-check)
            ver_check
            ;;
        self-update)
            inst_self_update
            ;;
        self-uninstall)
            inst_self_uninstall
            ;;
        install)
            # Ship-unit install only (Type 0). Stack ensure is setup/run domain path.
            inst_perform_install
            ;;
        setup)
            util_src_user_shell_conf 2>/dev/null || true
            env_check_alpine 2>/dev/null || true
            setup_sdkman
            setup_java_21
            setup_maven_3_9
            ruo_clone
            if [ "${NO_RUN}" -eq 0 ]; then
                ruo_build_run
            else
                out_success "Environment and project setup completed (--no-run)."
                out_success "Project location: ${PROJECT_DIR}"
            fi
            ;;
        mariadb|mysql|db)
            util_src_user_shell_conf 2>/dev/null || true
            db_setup
            ;;
        redis)
            util_src_user_shell_conf 2>/dev/null || true
            setup_redis_for_ruoyi
            ;;
        run)
            util_src_user_shell_conf 2>/dev/null || true
            ruo_build_run
            ;;
        db-extract)
            db_extract_credentials
            ;;
        help|*)
            ruo_help
            ;;
    esac
}


