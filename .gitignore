# =============================================================================
# .gitignore — ruoyi (product)
# =============================================================================

# Secrets / local env
.env
.env.*
!.env.example
!.env.sample
*.pem

# OS
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# Editors / IDEs
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# Python
__pycache__/
*.py[cod]
.Python
.venv/
venv/
env/

# ShellParser / build debris
target/

# Backup / temp
*.tmp
*.log
*.bak
*.before-full-rename.*
git-sync.20[0-9][0-9][0-9][0-9][0-9][0-9]-*

# Local specialize archives (not product ship)
.specialize-archive/

# Local H1/H2 hop backups (not product)
.h1-backup-*/
.h2-backup-*/

# Harness agent OS contract (workspace-local; not product public entry)
AGENTS.md

# Agent harness / local cadence (Pattern A: track docs/requirements/**)
docs/skills/
docs/terminologies/
docs/policies/
docs/templates/
docs/human-intro/
docs/housekeeping/
docs/incidents/
docs/README.md
docs/.gitignore
# New filled checklists stay local; already-tracked files remain in the index
docs/checklists/

# Bootstrap reference binary if present only as local freeze (keep product ship unit ruoyi)
# selfmanaged is optional local reference — ignore by default to avoid reverse-copy pollution in product tree
selfmanaged
selfmanaged.sha256
selfmanaged.*
